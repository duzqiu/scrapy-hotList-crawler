# Copy this file to .env before running docker compose.
TZ=Asia/Shanghai

# Git source pulled during Docker image build.
GIT_REPOSITORY=https://github.com/duzqiu/scrapy-hotList-crawler.git
GIT_REF=main

# Scheduled crawl interval in seconds; each round picks a random delay in the
# inclusive range. Defaults: 1800-5400 (30-90 minutes).
CRAWL_INTERVAL_MIN_SECONDS=1800
CRAWL_INTERVAL_MAX_SECONDS=5400

# true: write items into PostgreSQL and de-duplicate in Redis.
# false: do not connect to either service; items are only written to the log.
SCRAPY_PERSISTENCE_ENABLED=false

# PostgreSQL target used when persistence is enabled.
PG_HOST=192.168.31.201
PG_PORT=5452
PG_DATABASE=admin_db
PG_USER=postgres
PG_PASSWORD=123456
PG_CONNECT_TIMEOUT=10

# Redis used for de-duplication when persistence is enabled.
REDIS_URL=redis://192.168.31.201:6379/0
REDIS_CONNECT_TIMEOUT=10
REDIS_SOCKET_TIMEOUT=10
REDIS_DEDUPE_TTL=2592000
